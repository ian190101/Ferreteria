APP_NAME="Fabrica Calmina Aroma"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ASSET_URL=

# Local: deja TRUSTED_PROXIES vacio. Cloudflare Tunnel: usa TRUSTED_PROXIES=*
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fabrica_calmina_aroma
DB_USERNAME=root
DB_PASSWORD=
DB_PERSISTENT=false

# Produccion de una instancia: file. Multi-servidor: redis o database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
FILESYSTEM_LOCAL_SERVE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Local sin Redis: file evita depender de servicios externos. Render/produccion: redis.
CACHE_STORE=file
# CACHE_PREFIX=

# Rendimiento portable. Redis acelera, pero estos valores tambien funcionan con file/database cache.
DASHBOARD_CACHE_SECONDS=120
REPORTS_CACHE_SECONDS=180
UI_CATALOG_CACHE_MINUTES=30
UI_RECENT_CUSTOMERS_CACHE_MINUTES=15
UI_COILS_CACHE_SECONDS=90
RUN_STARTUP_MIGRATIONS=true
RUN_STARTUP_CACHE_WARM=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# En Render usa REDIS_URL con la URL interna del Key Value.
# REDIS_URL=redis://usuario:password@host:6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
TECHNICAL_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Facturacion Bolivia SIAT. Tokens/certificados se registran por sucursal desde el sistema.
SIAT_PILOT_BASE=https://pilotosiatservicios.impuestos.gob.bo/v2
SIAT_PRODUCTION_BASE=https://siatservicios.impuestos.gob.bo/v2
SIAT_PILOT_QR_BASE=https://pilotosiat.impuestos.gob.bo/consulta/QR
SIAT_PRODUCTION_QR_BASE=https://siat.impuestos.gob.bo/consulta/QR
SIAT_TEST_NIT=123456789
SIAT_TEST_BUSINESS_NAME="EMPRESA PILOTO SIAT"
SIAT_TEST_MUNICIPALITY="Santa Cruz"
SIAT_TEST_PHONE=70000000
SIAT_TEST_SYSTEM_CODE=CODIGO-SISTEMA-PILOTO
SIAT_TEST_TOKEN=
SIAT_TEST_ECONOMIC_ACTIVITY_CODE=471100
SIAT_TEST_SIN_PRODUCT_CODE=99100
SIAT_TEST_BRANCH_CODE=0
SIAT_TEST_POS_CODE=0
